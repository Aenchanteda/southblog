<div class="genome-controls" data-genome-controls>
  <label>跳至原讲义第 <select data-lecture-jump aria-label="跳至讲义页码">
    {Array.from({ length: 109 }, (_, i) => <option value={i + 1}>{i + 1}</option>)}
  </select> 页</label>
  <span data-lecture-current aria-live="polite">共109页</span>
  <a data-lecture-resume hidden href="#lecture-page-1">继续上次阅读</a>
</div>

<style is:global>
  .genome-controls { display:flex; flex-wrap:wrap; align-items:center; gap:12px 20px; padding:12px 0; margin:20px 0; border-block:1px solid var(--line); font-size:14px; }
  .genome-controls select { font:inherit; color:inherit; background:var(--bg); border:1px solid var(--line-strong); padding:3px 8px; }
  .genome-controls [hidden] { display:none; }
  .prose .genome-figure { margin:18px 0; }
  .prose .genome-figure img { display:block; width:100%; height:auto; cursor:zoom-in; }
  .prose .genome-figure figcaption { margin-top:6px; font-size:13px; color:var(--muted); }
  [id^="lecture-page-"] { scroll-margin-top:24px; }
  @media print { .genome-controls { display:none; } }
</style>

<script is:inline>
  (() => {
    const init = () => {
      const controls = document.querySelector('[data-genome-controls]');
      if (!controls) return;
      const jump = controls.querySelector('[data-lecture-jump]');
      const current = controls.querySelector('[data-lecture-current]');
      const resume = controls.querySelector('[data-lecture-resume]');
      const key = 'southblog:genome-stability:page';
      try {
        const saved = Number(localStorage.getItem(key));
        if (saved >= 1 && saved <= 109 && Number.isInteger(saved)) {
          resume.hidden = false;
          resume.href = '#lecture-page-' + saved;
          resume.textContent = '继续阅读：第 ' + saved + ' 页';
        }
      } catch {}
      jump.addEventListener('change', () => { location.hash = 'lecture-page-' + jump.value; });
      let interacted = false;
      window.addEventListener('scroll', () => { interacted = true; }, { passive: true });
      if (!('IntersectionObserver' in window)) return;
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const page = entry.target.dataset.lecturePage;
          jump.value = page;
          current.textContent = '当前：第 ' + page + ' / 109 页';
          if (interacted) { try { localStorage.setItem(key, page); } catch {} }
        }
      }, { rootMargin: '-10% 0px -60% 0px' });
      document.querySelectorAll('[data-lecture-page]').forEach((figure) => observer.observe(figure));
    };
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once:true });
    else init();
  })();
</script>
