---
import { siteConfig } from '../site.config';

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActivePath = (href: string) => {
  const itemPath = href.replace(/\/$/, '') || '/';
  return currentPath === itemPath || (itemPath !== '/' && currentPath.startsWith(`${itemPath}/`));
};
const topicActive = siteConfig.topics.some((item) => isActivePath(item.href));
const primaryNav = siteConfig.nav.filter((item) => item.href !== '/about');
const trailingNav = siteConfig.nav.filter((item) => item.href === '/about');
---

<header class="site-header">
  <div class="nav-frame">
    <a class="brand" href="/" aria-label={`${siteConfig.name} 首页`}>{siteConfig.name}</a>
    <nav class="site-nav" aria-label="主导航">
      {primaryNav.map((item) => (
        <a href={item.href} aria-current={isActivePath(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <div class="topic-dropdown" data-topic-dropdown>
        <button
          class="topic-trigger"
          type="button"
          aria-haspopup="true"
          aria-expanded="false"
          aria-current={topicActive ? 'page' : undefined}
          data-topic-trigger
        >
          专题<span aria-hidden="true">▾</span>
        </button>
        <div class="topic-menu" role="menu" data-topic-menu>
          {siteConfig.topics.map((item) => (
            <a href={item.href} role="menuitem" aria-current={isActivePath(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </div>
      </div>
      {trailingNav.map((item) => (
        <a href={item.href} aria-current={isActivePath(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  (() => {
    const dropdowns = document.querySelectorAll('[data-topic-dropdown]');

    const setOpen = (dropdown, open) => {
      dropdown.classList.toggle('is-open', open);
      dropdown.querySelector('[data-topic-trigger]')?.setAttribute('aria-expanded', String(open));
    };

    dropdowns.forEach((dropdown) => {
      const trigger = dropdown.querySelector('[data-topic-trigger]');
      const menu = dropdown.querySelector('[data-topic-menu]');
      if (!trigger || !menu) return;

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        setOpen(dropdown, !dropdown.classList.contains('is-open'));
      });

      dropdown.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          setOpen(dropdown, false);
          trigger.focus();
        }
      });
    });

    document.addEventListener('click', (event) => {
      dropdowns.forEach((dropdown) => {
        if (!dropdown.contains(event.target)) setOpen(dropdown, false);
      });
    });
  })();
</script>
