---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { byNewest, byOldest, formatDate, getEntrySlug, isBciEntry, isPublished } from '../lib/content';

const blogPosts = (await getCollection('blog')).filter(isPublished).sort(byNewest);
const bciPosts = blogPosts.filter(isBciEntry).sort(byOldest);
const aiPharmaPosts = (await getCollection('aiPharma')).filter(isPublished).sort(byOldest);
const genomicsPosts = (await getCollection('genomics')).filter(isPublished).sort(byOldest);

const latestItems = [
  ...blogPosts.filter((entry) => !isBciEntry(entry)).slice(0, 2).map((entry) => ({ entry, href: `/blog/${getEntrySlug(entry)}`, label: '博客' })),
  ...blogPosts.filter(isBciEntry).slice(0, 1).map((entry) => ({ entry, href: `/blog/${getEntrySlug(entry)}`, label: '脑机接口' })),
  ...aiPharmaPosts.slice(-1).map((entry) => ({ entry, href: `/ai-pharma/${getEntrySlug(entry)}`, label: 'AI制药' })),
  ...genomicsPosts.slice(-1).map((entry) => ({ entry, href: `/genomics/${getEntrySlug(entry)}`, label: '基因组学' })),
]
  .sort((a, b) => byNewest(a.entry, b.entry))
  .slice(0, 5);

const sections = [
  {
    index: '01',
    eyebrow: 'Latest',
    title: '最新更新',
    href: '/blog',
    linkText: '全部文章',
    items: latestItems,
  },
  {
    index: '02',
    eyebrow: 'BCI',
    title: '脑机接口',
    href: '/bci',
    linkText: '课程笔记',
    items: bciPosts.map((entry, index) => ({ entry, href: `/blog/${getEntrySlug(entry)}`, label: `第${index + 1}讲` })),
  },
  {
    index: '03',
    eyebrow: 'AI Drug Discovery',
    title: 'AI制药',
    href: '/ai-pharma',
    linkText: '全部文章',
    items: aiPharmaPosts.map((entry, index) => ({ entry, href: `/ai-pharma/${getEntrySlug(entry)}`, label: String(index + 1).padStart(2, '0') })),
  },
  {
    index: '04',
    eyebrow: 'Genomics',
    title: '基因组学',
    href: '/genomics',
    linkText: '全部文章',
    items: genomicsPosts.map((entry, index) => ({ entry, href: `/genomics/${getEntrySlug(entry)}`, label: String(index + 1).padStart(2, '0') })),
  },
];
---

<BaseLayout>
  <section class="home-intro" aria-labelledby="home-title">
    <p class="home-kicker">Personal notes / digital garden</p>
    <h1 id="home-title">{siteConfig.name}</h1>
    <p>
      写博客，也整理课程笔记。主题从脑机接口到 AI 制药、基因组学，尽量把学习路径留下清楚的索引。
    </p>
  </section>

  <div class="home-stream">
    {sections.map((section) => (
      <section class="home-list-section" aria-labelledby={`home-section-${section.index}`}>
        <div class="home-list-heading">
          <div class="home-list-titleline">
            <span class="home-list-index">{section.index}</span>
            <div>
              <p>{section.eyebrow}</p>
              <h2 id={`home-section-${section.index}`}>{section.title}</h2>
            </div>
          </div>
          <a href={section.href}>{section.linkText}</a>
        </div>
        <div class="home-post-list">
          {section.items.map(({ entry, href, label }) => (
            <a class="home-post-row" href={href}>
              <time datetime={entry.data.pubDate.toISOString()}>{formatDate(entry.data.pubDate)}</time>
              <div class="home-post-main">
                <h3>{entry.data.title}</h3>
                <p>{entry.data.description}</p>
              </div>
              <span>{label}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
