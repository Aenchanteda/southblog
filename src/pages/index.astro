---
import { getCollection } from 'astro:content';
import PostList, { type PostListItem } from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
import { byLessonOrder, byNewest, getEntrySlug, getOrderLabel, isBciEntry, isPublished, type ArticleEntry } from '../lib/content';

const blogPosts = (await getCollection('blog')).filter(isPublished);
const notesPosts = (await getCollection('notes')).filter(isPublished);
const bciPosts = blogPosts.filter(isBciEntry).sort(byLessonOrder);
const aiPharmaPosts = (await getCollection('aiPharma')).filter(isPublished).sort(byLessonOrder);
const genomicsPosts = (await getCollection('genomics')).filter(isPublished).sort(byLessonOrder);
const miscPosts = (await getCollection('misc')).filter(isPublished).sort(byLessonOrder);

const toItem = (entry: ArticleEntry, href: string, label?: string, title = entry.data.title): PostListItem => ({
  href,
  title,
  date: entry.data.pubDate,
  label,
  summary: entry.data.description,
});

// 最新更新：与 /blog 归档同源（全部内容集合），严格按发布日期倒序，取最新 6 篇。
const latestItems = [
  ...blogPosts.map((entry) => toItem(entry, `/blog/${getEntrySlug(entry)}`, isBciEntry(entry) ? '脑机接口' : '博客')),
  ...notesPosts.map((entry) => toItem(entry, `/notes/${getEntrySlug(entry)}`, '学习心得')),
  ...aiPharmaPosts.map((entry) => toItem(entry, `/ai-pharma/${getEntrySlug(entry)}`, 'AI制药')),
  ...genomicsPosts.map((entry) => toItem(entry, `/genomics/${getEntrySlug(entry)}`, '基因组学')),
  ...miscPosts.map((entry) => toItem(entry, `/misc/${getEntrySlug(entry)}`, '杂谈')),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);

const topicSections = [
  {
    id: 'bci',
    title: '脑机接口',
    href: '/bci',
    items: bciPosts.map((entry, index) =>
      toItem(entry, `/blog/${getEntrySlug(entry)}`, getOrderLabel(entry, index), entry.data.title)
    ),
  },
  {
    id: 'ai-pharma',
    title: 'AI制药',
    href: '/ai-pharma',
    items: aiPharmaPosts.map((entry, index) => toItem(entry, `/ai-pharma/${getEntrySlug(entry)}`, getOrderLabel(entry, index))),
  },
  {
    id: 'genomics',
    title: '基因组学',
    href: '/genomics',
    items: genomicsPosts.map((entry, index) => toItem(entry, `/genomics/${getEntrySlug(entry)}`, getOrderLabel(entry, index))),
  },
  {
    id: 'misc',
    title: '杂谈',
    href: '/misc',
    items: miscPosts.map((entry, index) => toItem(entry, `/misc/${getEntrySlug(entry)}`, getOrderLabel(entry, index))),
  },
].filter((section) => section.items.length > 0);
---

<BaseLayout>
  <h1 class="sr-only">{siteConfig.name}</h1>
  <p class="home-intro">{siteConfig.intro}</p>

  <section class="home-section" aria-labelledby="home-latest">
    <div class="section-head">
      <h2 id="home-latest">最新更新</h2>
      <a href="/blog">全部文章 →</a>
    </div>
    <PostList items={latestItems} showSummary />
  </section>

  {topicSections.map((section) => (
    <section class="home-section" aria-labelledby={`home-${section.id}`}>
      <div class="section-head">
        <h2 id={`home-${section.id}`}>{section.title}</h2>
        <a href={section.href}>全部文章 →</a>
      </div>
      <PostList items={section.items} variant="ordered" />
    </section>
  ))}
</BaseLayout>
