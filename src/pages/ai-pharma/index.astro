---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byLessonOrder, getEntrySlug, getOrderLabel, isPublished } from '../../lib/content';

const posts = (await getCollection('aiPharma'))
  .filter(isPublished)
  .sort(byLessonOrder);
const items = posts.map((entry, index) => ({
  href: `/ai-pharma/${getEntrySlug(entry)}`,
  title: entry.data.title,
  date: entry.data.pubDate,
  label: getOrderLabel(entry, index),
}));
---

<BaseLayout title="AI制药" description="南边小站的 AI 制药与小分子药物发现学习文章。">
  <header class="list-header">
    <h1>AI制药</h1>
    <p>小分子药物发现、分子表示、性质预测、生成式模型与学习路线的长期笔记。</p>
  </header>
  <PostList items={items} variant="ordered" />
</BaseLayout>
