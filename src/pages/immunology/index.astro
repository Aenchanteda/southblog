---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byLessonOrder, getEntrySlug, getOrderLabel, isPublished } from '../../lib/content';

const posts = (await getCollection('immunology'))
  .filter(isPublished)
  .sort(byLessonOrder);
const items = posts.map((entry, index) => ({
  href: `/immunology/${getEntrySlug(entry)}`,
  title: entry.data.title,
  date: entry.data.pubDate,
  label: getOrderLabel(entry, index),
}));
---

<BaseLayout title="基础免疫学" description="南边小站的基础免疫学课堂笔记。">
  <header class="list-header">
    <h1>基础免疫学</h1>
    <p>按课次整理的免疫学课堂笔记，每讲附原始课件 PDF。教材 Janeway's Immunobiology 见 <a href="/books/01-janeways-immunobiology-10th">推荐书目</a>。</p>
  </header>
  <PostList items={items} variant="ordered" />
</BaseLayout>
