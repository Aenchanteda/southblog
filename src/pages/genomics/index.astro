---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byLessonOrder, getEntrySlug, getOrderLabel, isPublished } from '../../lib/content';

const posts = (await getCollection('genomics'))
  .filter(isPublished)
  .sort(byLessonOrder);
const items = posts.map((entry, index) => ({
  href: `/genomics/${getEntrySlug(entry)}`,
  title: entry.data.title,
  date: entry.data.pubDate,
  label: getOrderLabel(entry, index),
}));
---

<BaseLayout title="基因组学" description="南边小站的基因组学与分子基础学习文章。">
  <header class="list-header">
    <h1>基因组学</h1>
    <p>从 DNA、核苷酸与分子结构基础开始，整理可长期回看的基因组学笔记。</p>
  </header>
  <PostList items={items} variant="ordered" />
</BaseLayout>
