---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byLessonOrder, getEntrySlug, isPublished, isBciEntry } from '../../lib/content';

const posts = (await getCollection('blog'))
  .filter(isPublished)
  .filter(isBciEntry)
  .sort(byLessonOrder);
const items = posts.map((entry, index) => ({
  href: `/blog/${getEntrySlug(entry)}`,
  title: entry.data.title.replace(/^第\s*\d+\s*讲\s*[·・:：\-—]\s*/, ''),
  date: entry.data.pubDate,
  label: `第${entry.data.order ?? index + 1}讲`,
}));
---

<BaseLayout title="脑机接口" description="南边小站的脑机接口课程笔记与相关文章。">
  <header class="list-header">
    <h1>脑机接口</h1>
    <p>脑机接口课程笔记与相关文章，按课程顺序排列。</p>
  </header>
  <PostList items={items} variant="ordered" />
</BaseLayout>
