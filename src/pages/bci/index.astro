---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byLessonOrder, getEntrySlug, getOrderLabel, isBciEntry, isPublished } from '../../lib/content';

const posts = (await getCollection('blog'))
  .filter(isPublished)
  .filter(isBciEntry)
  .sort(byLessonOrder);
const items = posts.map((entry, index) => ({
  href: `/blog/${getEntrySlug(entry)}`,
  title: entry.data.title,
  date: entry.data.pubDate,
  label: getOrderLabel(entry, index),
}));
---

<BaseLayout title="脑机接口" description="南边小站的脑机接口课程笔记与相关文章。">
  <p class="post-back"><a href="/">← 返回首页</a></p>
  <header class="list-header">
    <h1>脑机接口</h1>
    <p>脑机接口课程笔记与相关文章，按课程顺序排列。</p>
  </header>
  <PostList items={items} variant="ordered" />
</BaseLayout>
