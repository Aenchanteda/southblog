---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adjacentLinks, byLessonOrder, getEntrySlug, isPublished } from '../../lib/content';

type Entry = CollectionEntry<'books'>;

export async function getStaticPaths() {
  const posts = (await getCollection('books')).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Entry };
const { Content, headings } = await render(post);
const sectionLabel = '推荐书目';
const sectionHref = '/books';
const published = (await getCollection('books')).filter(isPublished).sort(byLessonOrder);
const { prev, next } = adjacentLinks(published, post.id, (entry) => `/books/${getEntrySlug(entry)}`);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ArticleView
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    sectionLabel={sectionLabel}
    sectionHref={sectionHref}
    tags={post.data.tags}
    headings={headings}
    prev={prev}
    next={next}
  >
    <Content />
  </ArticleView>
</BaseLayout>
