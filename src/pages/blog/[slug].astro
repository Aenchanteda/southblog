---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import ArticleView from '../../components/ArticleView.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { adjacentLinks, byLessonOrder, byOldest, getEntrySlug, isBciEntry, isPublished } from '../../lib/content';

type Entry = CollectionEntry<'blog'>;

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(isPublished);
  return posts.map((post) => ({
    params: { slug: getEntrySlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props as { post: Entry };
const { Content, headings } = await render(post);
const isBci = isBciEntry(post);
const sectionLabel = isBci ? '脑机接口' : '博客';
const sectionHref = isBci ? '/bci' : '/blog';
const published = (await getCollection('blog')).filter(isPublished);
const series = (isBci ? published.filter(isBciEntry) : published.filter((entry) => !isBciEntry(entry))).sort(
  isBci ? byLessonOrder : byOldest,
);
const { prev, next } = adjacentLinks(series, post.id, (entry) => `/blog/${getEntrySlug(entry)}`);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <ArticleView
    title={post.data.title}
    description={post.data.description}
    pubDate={post.data.pubDate}
    sectionLabel={sectionLabel}
    sectionHref={sectionHref}
    tags={post.data.tags}
    headings={headings}
    prev={prev}
    next={next}
  >
    <Content />
  </ArticleView>
</BaseLayout>
