---
import { getCollection } from 'astro:content';
import PostList, { type PostListItem } from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntrySlug, getYear, isBciEntry, isPublished, type ArticleEntry } from '../../lib/content';

const toItem = (entry: ArticleEntry, href: string, label: string): PostListItem => ({
  href,
  title: entry.data.title,
  date: entry.data.pubDate,
  label,
});

const posts = [
  ...(await getCollection('blog')).filter(isPublished).map((entry) => toItem(entry, `/blog/${getEntrySlug(entry)}`, isBciEntry(entry) ? '脑机接口' : '博客')),
  ...(await getCollection('notes')).filter(isPublished).map((entry) => toItem(entry, `/notes/${getEntrySlug(entry)}`, '学习心得')),
  ...(await getCollection('aiPharma')).filter(isPublished).map((entry) => toItem(entry, `/ai-pharma/${getEntrySlug(entry)}`, 'AI制药')),
  ...(await getCollection('genomics')).filter(isPublished).map((entry) => toItem(entry, `/genomics/${getEntrySlug(entry)}`, '基因组学')),
].sort((a, b) => b.date.getTime() - a.date.getTime());

const years = [...new Set(posts.map((post) => getYear(post.date)))];
const groups = years.map((year) => ({ year, items: posts.filter((post) => getYear(post.date) === year) }));
---

<BaseLayout title="博客" description="南边小站的全部文章归档。">
  <header class="list-header">
    <h1>博客</h1>
    <p>全部文章归档，按发布时间倒序，共 {posts.length} 篇。</p>
  </header>
  {groups.map((group) => (
    <section class="year-group" aria-labelledby={`year-${group.year}`}>
      <h2 id={`year-${group.year}`}>{group.year}</h2>
      <PostList items={group.items} dateFormat="month-day" />
    </section>
  ))}
</BaseLayout>
