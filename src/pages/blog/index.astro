---
import { getCollection } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, isBciEntry, isPublished } from '../../lib/content';

const blogPosts = (await getCollection('blog')).filter(isPublished).map((entry) => ({
  entry,
  section: 'blog' as const,
  label: isBciEntry(entry) ? '脑机接口' : '博客',
}));
const notes = (await getCollection('notes')).filter(isPublished).map((entry) => ({ entry, section: 'notes' as const, label: '学习心得' }));
const aiPharmaPosts = (await getCollection('aiPharma')).filter(isPublished).map((entry) => ({ entry, section: 'ai-pharma' as const, label: 'AI制药' }));
const genomicsPosts = (await getCollection('genomics')).filter(isPublished).map((entry) => ({ entry, section: 'genomics' as const, label: '基因组学' }));
const posts = [...blogPosts, ...notes, ...aiPharmaPosts, ...genomicsPosts].sort((a, b) => byNewest(a.entry, b.entry));
---

<BaseLayout title="博客" description="南边小站的全部文章归档。">
  <section class="content-panel">
    <div class="list-header">
      <p class="eyebrow">Article Archive</p>
      <h1>博客</h1>
      <p class="lead">全部已发布文章归档，包含博客、脑机接口、AI制药、基因组学与学习心得，按发布时间倒序排列。</p>
    </div>
    <div class="article-grid">
      {posts.map(({ entry, section, label }) => <ArticleCard entry={entry} section={section} sectionLabel={label} />)}
    </div>
  </section>
</BaseLayout>
