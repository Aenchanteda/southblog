---
import { getCollection } from 'astro:content';
import PostList from '../../components/PostList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { byNewest, getEntrySlug, isPublished } from '../../lib/content';

const notes = (await getCollection('notes')).filter(isPublished).sort(byNewest);
const items = notes.map((entry) => ({
  href: `/notes/${getEntrySlug(entry)}`,
  title: entry.data.title,
  date: entry.data.pubDate,
  summary: entry.data.description,
}));
---

<BaseLayout title="学习心得" description="南边小站的学习心得与笔记列表。">
  <header class="list-header">
    <h1>学习心得</h1>
    <p>更轻量的学习记录：问题、理解路径和可复用的小结。</p>
  </header>
  <PostList items={items} showSummary />
</BaseLayout>
