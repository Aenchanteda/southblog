---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';
---

<BaseLayout title="关于" description="关于南边小站。">
  <div class="plain-page">
    <header class="list-header">
      <h1>关于 {siteConfig.name}</h1>
      <p>{siteConfig.description}</p>
    </header>
    <div class="prose">
      <p>
        {siteConfig.name}由 {siteConfig.author} 维护，用来写博客、整理课程笔记和学习心得，目前的专题包括脑机接口、AI 制药与基因组学。
      </p>
      <p>
        内容使用 Markdown/MDX 与 Astro Content Collections 管理，既适合普通文章，也方便在需要时加入组件化内容。
      </p>
    </div>
  </div>
</BaseLayout>
