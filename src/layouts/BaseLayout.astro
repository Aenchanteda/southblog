---
import Header from '../components/Header.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.alternateName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/pt-serif@5/400.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/pt-serif@5/400-italic.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5/400.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/noto-serif-sc@5/500.css" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="page-shell">
      <slot />
    </main>
    <footer class="site-footer">
      <p>© {new Date().getFullYear()} {siteConfig.author} · Powered by Astro</p>
    </footer>
  </body>
</html>

<style is:global>
  /*
   * Minimal academic style, modelled on leimao.github.io (Hexo Icarus):
   * serif text, neutral grays, one blue link color, plain date + title lists,
   * thin rules, no decoration. Unlike the reference we drop its white cards
   * on a gray page and put everything on plain white.
   */
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --ink: #222222;
    --ink-soft: #444444;
    --muted: #777777;
    --faint: #999999;
    --line: #e6e6e6;
    --line-strong: #d4d4d4;
    --code-bg: #f6f6f6;
    --link: #2a5a9e;
    --link-hover: #1a3f75;
    --column: 760px;
    --wide: 1200px;
    --font-serif: "PT Serif", "Noto Serif SC", "Source Han Serif SC", "Songti SC", "STSong", SimSun, serif;
    --font-mono: "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    font-family: var(--font-serif);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    color: var(--ink);
    font-size: 16px;
    font-weight: 400;
    line-height: 1.8;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--link);
    text-decoration: none;
  }

  a:hover {
    color: var(--link-hover);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  img,
  svg {
    max-width: 100%;
  }

  code,
  pre {
    font-family: var(--font-mono);
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--ink);
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }

  p {
    margin: 0;
  }

  strong,
  b {
    font-weight: 500;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  /* ---------- Header ---------- */

  .site-header {
    border-bottom: 1px solid var(--line);
  }

  .nav-frame {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    width: min(var(--column), calc(100% - 40px));
    margin: 0 auto;
    padding: 18px 0 14px;
  }

  .brand {
    flex-shrink: 0;
    color: var(--ink);
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .brand:hover {
    color: var(--ink);
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: baseline;
    gap: 22px;
    min-width: 0;
  }

  .site-nav a,
  .topic-trigger {
    appearance: none;
    border: 0;
    background: none;
    color: var(--ink-soft);
    cursor: pointer;
    font: inherit;
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 0;
    white-space: nowrap;
  }

  .site-nav a:hover,
  .topic-trigger:hover {
    color: var(--link);
    text-decoration: none;
  }

  .site-nav a[aria-current="page"],
  .topic-trigger[aria-current="page"] {
    color: var(--link);
  }

  .topic-dropdown {
    position: relative;
  }

  .topic-trigger span {
    display: inline-block;
    margin-left: 2px;
    color: var(--faint);
    font-size: 0.7em;
    transition: transform 150ms ease;
  }

  .topic-menu {
    position: absolute;
    top: 100%;
    right: -12px;
    z-index: 40;
    display: none;
    min-width: 120px;
    padding: 6px 0;
    border: 1px solid var(--line-strong);
    background: #fff;
  }

  /* hover bridge so the pointer can travel from trigger to menu */
  .topic-menu::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -10px;
    height: 10px;
  }

  .topic-dropdown.is-open .topic-menu,
  .topic-dropdown:has(:focus-visible) .topic-menu {
    display: block;
  }

  .topic-dropdown.is-open .topic-trigger span,
  .topic-dropdown:has(:focus-visible) .topic-trigger span {
    transform: rotate(180deg);
  }

  @media (hover: hover) {
    .topic-dropdown:hover .topic-menu {
      display: block;
    }

    .topic-dropdown:hover .topic-trigger span {
      transform: rotate(180deg);
    }
  }

  .topic-menu a {
    display: block;
    padding: 4px 14px;
  }

  .topic-menu a:hover {
    background: #f6f6f6;
  }

  /* ---------- Page shell ---------- */

  .page-shell {
    flex: 1;
    width: min(var(--column), calc(100% - 40px));
    margin: 0 auto;
    padding: 36px 0 64px;
  }

  .page-shell:has(> .post-shell.with-toc) {
    width: min(var(--wide), calc(100% - 40px));
  }

  /* ---------- Home ---------- */

  .home-intro {
    color: var(--ink-soft);
    margin-bottom: 30px;
  }

  .home-section + .home-section {
    margin-top: 34px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 6px;
    margin-bottom: 4px;
  }

  .section-head h2 {
    font-size: 1.15rem;
    letter-spacing: 0.02em;
  }

  .section-head a {
    flex-shrink: 0;
    font-size: 0.875rem;
  }

  /* ---------- Post lists (home, archive, topics) ---------- */

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-row {
    display: grid;
    grid-template-columns: 6.6em minmax(0, 1fr);
    gap: 16px;
    align-items: baseline;
    padding: 7px 0;
  }

  .post-list-ordered .post-row {
    grid-template-columns: 3.8em minmax(0, 1fr) auto;
  }

  .post-row-date,
  .post-row-index {
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-row-main {
    min-width: 0;
  }

  .post-row-title {
    font-size: 1rem;
    line-height: 1.6;
  }

  .post-row-sub {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.6;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .post-row-label + .post-row-summary::before {
    content: "·";
    margin: 0 0.5em;
  }

  .post-list-month-day .post-row {
    grid-template-columns: 3.6em minmax(0, 1fr);
  }

  /* ---------- List pages ---------- */

  .list-header {
    margin-bottom: 26px;
  }

  .list-header h1 {
    font-size: 1.6rem;
    margin-bottom: 6px;
  }

  .list-header p {
    color: var(--muted);
  }

  .year-group + .year-group {
    margin-top: 26px;
  }

  .year-group h2 {
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
    padding-bottom: 4px;
    margin-bottom: 4px;
  }

  .plain-page .prose {
    margin-top: 0;
  }

  /* ---------- Article ---------- */

  .post-shell {
    width: 100%;
    max-width: var(--column);
    margin: 0 auto;
    min-width: 0;
  }

  .post-header {
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
    min-width: 0;
  }

  .post-header h1 {
    font-size: 28px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.01em;
    overflow-wrap: anywhere;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;
    margin-top: 8px;
    color: var(--muted);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
  }

  .post-meta a {
    color: var(--muted);
  }

  .post-meta a:hover {
    color: var(--link);
  }

  .post-lead {
    margin-top: 12px;
    color: var(--ink-soft);
    font-size: 1rem;
  }

  .with-toc > .post-header {
    border-bottom: 0;
    margin-bottom: 14px;
    padding-bottom: 0;
  }

  .article-toc {
    border-top: 1px solid var(--line);
    padding-top: 10px;
    min-width: 0;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 10px;
  }

  .toc-toggle {
    appearance: none;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.9rem;
    padding: 0;
  }

  .toc-toggle span {
    display: inline-block;
    font-size: 0.75em;
    transition: transform 150ms ease;
  }

  .article-toc.is-open .toc-toggle span {
    transform: rotate(180deg);
  }

  .toc-panel {
    display: none;
    margin-top: 6px;
  }

  .article-toc.is-open .toc-panel {
    display: block;
  }

  .toc-title {
    display: none;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-list a {
    display: block;
    color: var(--ink-soft);
    font-size: 0.875rem;
    line-height: 1.55;
    padding: 3px 0;
    overflow-wrap: anywhere;
  }

  .toc-list a:hover,
  .toc-list a[aria-current] {
    color: var(--link);
    text-decoration: none;
  }

  .toc-depth-3 a {
    padding-left: 1em;
    color: var(--muted);
    font-size: 0.82rem;
  }

  @media (min-width: 1180px) {
    .post-shell.with-toc {
      display: grid;
      max-width: none;
      grid-template-columns: minmax(0, 1fr) var(--column) minmax(0, 1fr);
      grid-template-areas:
        "toc header ."
        "toc body .";
      column-gap: 36px;
    }

    .with-toc > .post-header {
      grid-area: header;
      border-bottom: 1px solid var(--line);
      margin-bottom: 28px;
      padding-bottom: 20px;
    }

    .with-toc > .prose {
      grid-area: body;
    }

    .with-toc > .article-toc {
      grid-area: toc;
      justify-self: end;
      align-self: start;
      position: sticky;
      top: 28px;
      width: 184px;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
      margin: 0;
      border: 0;
      padding: 6px 0 0;
    }

    .toc-toggle {
      display: none;
    }

    .toc-panel {
      display: block;
      margin: 0;
    }

    .toc-depth-3 {
      display: none;
    }

    .toc-depth-3.is-current-section {
      display: block;
    }

    .toc-title {
      display: block;
      color: var(--faint);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      margin-bottom: 6px;
    }
  }

  /* ---------- Prose ---------- */

  .prose {
    min-width: 0;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .prose > *:first-child {
    margin-top: 0;
  }

  .prose > *:last-child {
    margin-bottom: 0;
  }

  .prose > h1:first-child {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .prose h2 {
    scroll-margin-top: 24px;
    margin: 2.2em 0 0.7em;
    font-size: 1.35rem;
    line-height: 1.45;
  }

  .prose h3 {
    scroll-margin-top: 24px;
    margin: 1.8em 0 0.5em;
    font-size: 1.12rem;
    line-height: 1.5;
  }

  .prose h4 {
    margin: 1.5em 0 0.4em;
    font-size: 1rem;
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose blockquote,
  .prose pre,
  .prose table {
    margin: 0.9em 0;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.5em;
  }

  .prose li + li {
    margin-top: 0.3em;
  }

  .prose li::marker {
    color: var(--muted);
  }

  .prose ul.contains-task-list {
    list-style: none;
    padding-left: 0.2em;
  }

  .prose .task-list-item input[type="checkbox"] {
    margin: 0 0.5em 0 0;
    vertical-align: -0.1em;
    accent-color: var(--link);
  }

  .prose a {
    text-decoration: underline;
    text-decoration-color: rgba(42, 90, 158, 0.35);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose a:hover {
    text-decoration-color: currentColor;
  }

  .prose p:has(> img) {
    margin: 1.6em 0 0.4em;
    text-align: center;
  }

  .prose p:has(> img) img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .prose p:has(> img) + p {
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.7;
    margin: 0 0 1.6em;
    text-align: center;
  }

  .prose p:has(> img) + p em {
    font-style: normal;
  }

  .prose blockquote {
    border-left: 3px solid var(--line-strong);
    color: var(--ink-soft);
    margin-left: 0;
    margin-right: 0;
    padding: 0.1em 0 0.1em 1em;
  }

  .prose blockquote > :first-child {
    margin-top: 0;
  }

  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  .prose hr {
    height: 1px;
    border: 0;
    background: var(--line);
    margin: 2.4em 0;
  }

  .prose code {
    background: var(--code-bg);
    color: #333;
    font-size: 0.86em;
    padding: 0.1em 0.3em;
  }

  .prose pre {
    overflow-x: auto;
    border: 1px solid var(--line);
    background: #fafafa;
    color: #333;
    font-size: 0.85rem;
    line-height: 1.6;
    padding: 12px 14px;
  }

  .prose pre code {
    background: transparent;
    font-size: inherit;
    padding: 0;
  }

  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.9rem;
    line-height: 1.65;
    -webkit-overflow-scrolling: touch;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--line);
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
    min-width: 5em;
    overflow-wrap: normal;
  }

  .prose th {
    background: #f7f7f7;
    font-weight: 500;
  }

  /* ---------- Footer ---------- */

  .site-footer {
    width: min(var(--column), calc(100% - 40px));
    margin: 0 auto;
    border-top: 1px solid var(--line);
    color: var(--faint);
    font-size: 0.82rem;
    padding: 18px 0 32px;
  }

  /* ---------- Mobile ---------- */

  @media (max-width: 640px) {
    body {
      font-size: 15.5px;
    }

    .nav-frame,
    .page-shell,
    .site-footer {
      width: calc(100% - 32px);
    }

    .page-shell:has(> .post-shell.with-toc) {
      width: calc(100% - 32px);
    }

    .nav-frame {
      gap: 10px;
      padding: 12px 0 10px;
    }

    .brand {
      font-size: 1.05rem;
      letter-spacing: 0.02em;
    }

    .site-nav {
      gap: 12px;
    }

    .site-nav a,
    .topic-trigger {
      font-size: 0.875rem;
    }

    .topic-menu {
      right: -8px;
    }

    .page-shell {
      padding: 24px 0 48px;
    }

    .home-intro {
      margin-bottom: 22px;
    }

    .home-section + .home-section {
      margin-top: 26px;
    }

    .post-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding: 7px 0;
    }

    .post-row-date {
      font-size: 0.8rem;
      line-height: 1.5;
    }

    .post-list-ordered .post-row {
      grid-template-columns: 3.6em minmax(0, 1fr);
      gap: 8px;
    }

    .post-row-date-end {
      display: none;
    }

    .post-list-month-day .post-row {
      grid-template-columns: 3.4em minmax(0, 1fr);
      gap: 10px;
    }

    .post-header h1 {
      font-size: 23px;
    }

    .prose {
      font-size: 16px;
      line-height: 1.8;
    }

    .prose h2 {
      font-size: 1.22rem;
    }

    .prose h3 {
      font-size: 1.06rem;
    }

    .prose th,
    .prose td {
      padding: 5px 8px;
      min-width: 4.5em;
    }
  }
</style>
