---
import Header from '../components/Header.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.alternateName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-screen-webfont@1.7.0/style.css" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="page-shell">
      <Header />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>{siteConfig.name} · {siteConfig.alternateName}</p>
        <p>© {new Date().getFullYear()} {siteConfig.author}. Powered by Astro.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f5efe4;
    --bg-deep: #ece1d1;
    --paper: #fffaf1;
    --paper-soft: #fbf4e8;
    --paper-strong: #fffdf8;
    --ink: #24201a;
    --ink-soft: #595044;
    --muted: #7a6d5f;
    --line: rgba(86, 64, 39, 0.16);
    --line-strong: rgba(86, 64, 39, 0.26);
    --accent: #9f4f2f;
    --accent-soft: #e7c2a8;
    --accent-wash: rgba(159, 79, 47, 0.1);
    --green-ink: #475f48;
    --shadow-soft: 0 24px 80px rgba(61, 44, 25, 0.1);
    --shadow-card: 0 18px 50px rgba(61, 44, 25, 0.08);
    --radius-xl: 34px;
    --radius-lg: 24px;
    --radius-md: 16px;
    --content-width: 1120px;
    --reading-width: 70ch;
    --font-reading: "LXGW WenKai Screen", "LXGW WenKai", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
    --font-ui: "LXGW WenKai Screen", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", ui-sans-serif, system-ui, sans-serif;
    --font-serif: "LXGW WenKai Screen", "Noto Serif SC", "Source Han Serif SC", "Songti SC", SimSun, serif;
    --font-mono: "SFMono-Regular", "IBM Plex Mono", Consolas, "Liberation Mono", monospace;
    font-family: var(--font-reading);
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-size: 16px;
    font-weight: 400;
    letter-spacing: 0.01em;
    line-height: 1.86;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(67, 47, 24, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(67, 47, 24, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 72%);
    z-index: -2;
  }

  .site-bg {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -3;
  }

  .site-bg::before,
  .site-bg::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
  }

  .site-bg::before {
    width: min(58vw, 760px);
    height: min(58vw, 760px);
    left: -18vw;
    top: -22vw;
    background: radial-gradient(circle, rgba(231, 194, 168, 0.72), rgba(231, 194, 168, 0));
  }

  .site-bg::after {
    width: min(46vw, 620px);
    height: min(46vw, 620px);
    right: -14vw;
    top: 16vh;
    background: radial-gradient(circle, rgba(147, 166, 137, 0.28), rgba(147, 166, 137, 0));
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    max-width: 100%;
  }

  code,
  pre {
    font-family: var(--font-mono);
  }

  .page-shell {
    width: min(var(--content-width), calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding: 14px 0 18px;
  }

  .nav-frame {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 1px solid rgba(86, 64, 39, 0.1);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.72);
    box-shadow: 0 8px 28px rgba(61, 44, 25, 0.045);
    padding: 9px 10px 9px 12px;
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: max-content;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: linear-gradient(145deg, #a75332, #76351f);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 10px 22px rgba(121, 57, 31, 0.18);
    color: #fff8ef;
    font-weight: 600;
  }

  .brand-copy {
    display: grid;
    gap: 1px;
    line-height: 1.15;
  }

  .brand-copy strong {
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .brand-copy small {
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .site-nav a,
  .topic-trigger {
    appearance: none;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.94rem;
    font-weight: 500;
    line-height: 1;
    padding: 12px 15px;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
    white-space: nowrap;
  }

  .site-nav a:hover,
  .topic-trigger:hover {
    background: rgba(159, 79, 47, 0.08);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .site-nav a[aria-current="page"],
  .topic-trigger[aria-current="page"] {
    background: rgba(159, 79, 47, 0.1);
    color: var(--accent);
  }

  .topic-dropdown {
    position: relative;
  }

  .topic-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .topic-trigger span {
    flex-shrink: 0;
    font-size: 0.72rem;
    transition: transform 160ms ease;
  }

  .topic-dropdown.is-open .topic-trigger span,
  .topic-dropdown:hover .topic-trigger span,
  .topic-dropdown:focus-within .topic-trigger span {
    transform: rotate(180deg);
  }

  .topic-menu {
    position: absolute;
    top: calc(100% - 2px);
    right: 0;
    z-index: 40;
    display: grid;
    min-width: 150px;
    gap: 4px;
    border: 1px solid var(--line);
    border-radius: 18px;
    background: rgba(255, 250, 241, 0.96);
    box-shadow: 0 18px 50px rgba(61, 44, 25, 0.14);
    opacity: 0;
    padding: 8px;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 160ms ease, transform 160ms ease;
    backdrop-filter: blur(16px);
  }

  .topic-dropdown.is-open .topic-menu,
  .topic-dropdown:hover .topic-menu,
  .topic-dropdown:focus-within .topic-menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .topic-menu a {
    justify-content: flex-start;
    white-space: nowrap;
  }

  main {
    padding: 42px 0 78px;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(28px, 5vw, 60px);
    align-items: end;
    min-height: 520px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(125deg, rgba(255, 253, 248, 0.95), rgba(251, 244, 232, 0.86)),
      radial-gradient(circle at 82% 18%, rgba(159, 79, 47, 0.18), transparent 28rem);
    box-shadow: var(--shadow-soft);
    padding: clamp(32px, 7vw, 84px);
  }

  .home-hero {
    grid-template-columns: 1fr;
    align-items: center;
    min-height: auto;
    margin-top: -26px;
    padding: clamp(12px, 2vw, 20px) clamp(18px, 3vw, 30px);
  }

  .home-hero::before {
    inset: 8px;
    border-radius: 20px;
  }

  .home-hero .hero-content {
    gap: 4px;
  }

  .home-hero h1 {
    font-size: clamp(1.45rem, 3vw, 2.15rem);
    letter-spacing: -0.04em;
  }

  .home-hero p {
    max-width: 58ch;
    font-size: clamp(0.88rem, 1.2vw, 0.98rem);
    line-height: 1.56;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(86, 64, 39, 0.11);
    border-radius: calc(var(--radius-xl) - 12px);
    pointer-events: none;
  }

  .hero-content,
  .hero-card {
    position: relative;
  }

  .hero-content {
    display: grid;
    gap: 24px;
  }

  .hero-card {
    display: grid;
    gap: 16px;
    border: 1px solid rgba(86, 64, 39, 0.14);
    border-radius: var(--radius-lg);
    background: rgba(255, 253, 248, 0.72);
    padding: 26px;
  }

  .hero-card .stamp {
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(159, 79, 47, 0.32);
    border-radius: 20px;
    color: var(--accent);
    font-size: 1.55rem;
    font-weight: 600;
  }

  .home-intro {
    display: grid;
    gap: 6px;
    max-width: 760px;
    margin-top: -34px;
    padding: 4px 0 12px;
    border-bottom: 1px solid var(--line);
  }

  .home-kicker,
  .home-list-heading p {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0;
    text-transform: uppercase;
  }

  .home-intro h1 {
    font-size: clamp(1.8rem, 3.9vw, 3.05rem);
    letter-spacing: -0.055em;
  }

  .home-intro p:not(.home-kicker) {
    color: var(--ink-soft);
    font-size: clamp(0.98rem, 1.5vw, 1.1rem);
    line-height: 1.62;
    max-width: 62ch;
  }

  .home-stream {
    display: grid;
    gap: 20px;
    margin-top: 14px;
  }

  .home-list-section {
    display: grid;
    gap: 10px;
  }

  .home-list-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px;
    align-items: end;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }

  .home-list-titleline {
    display: flex;
    align-items: end;
    gap: 12px;
    min-width: 0;
  }

  .home-list-index {
    display: inline-grid;
    min-width: 34px;
    height: 24px;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
  }

  .home-list-heading h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.7vw, 1.45rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .home-list-heading a {
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.4;
    text-underline-offset: 5px;
    white-space: nowrap;
  }

  .home-list-heading a:hover {
    text-decoration: underline;
  }

  .home-post-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 26px;
  }

  .home-post-row {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr) auto;
    gap: 14px;
    align-items: baseline;
    min-width: 0;
    border-bottom: 1px solid rgba(86, 64, 39, 0.12);
    padding: 9px 0;
  }

  .home-post-row time,
  .home-post-row > span {
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.4;
    white-space: nowrap;
  }

  .home-post-row time {
    font-variant-numeric: tabular-nums;
  }

  .home-post-row > span {
    border: 1px solid rgba(159, 79, 47, 0.14);
    border-radius: 999px;
    color: var(--accent);
    font-weight: 500;
    padding: 2px 8px;
  }

  .home-post-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .home-post-main h3 {
    overflow: hidden;
    font-size: 0.98rem;
    font-weight: 400;
    letter-spacing: -0.015em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-post-main p {
    overflow: hidden;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.5;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .hero-meta span,
  .section-pill,
  .order-badge,
  .tag-list li {
    border: 1px solid rgba(159, 79, 47, 0.16);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.78);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 500;
    line-height: 1;
    padding: 7px 11px;
  }

  .eyebrow,
  .article-meta,
  .post-kicker {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    margin: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    line-height: 1.18;
    margin: 0;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 8vw, 6.6rem);
    font-weight: 500;
    letter-spacing: -0.07em;
  }

  h2 {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  h3 {
    font-size: clamp(1.18rem, 2vw, 1.38rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
  }

  .hero p,
  .lead {
    color: var(--ink-soft);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.9;
    max-width: 66ch;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin: 58px 0 22px;
  }

  .section-heading > div {
    display: grid;
    gap: 8px;
  }

  .section-heading a,
  .back-link {
    color: var(--accent);
    font-weight: 600;
    text-underline-offset: 5px;
  }

  .section-heading a:hover,
  .back-link:hover {
    text-decoration: underline;
  }

  .home-section {
    position: relative;
  }

  .home-hero + .home-section .section-heading {
    margin-top: 12px;
  }

  .home-section + .home-section {
    margin-top: 0;
  }

  .compact-section .section-heading {
    margin-top: 16px;
  }

  .home-section .section-heading {
    align-items: baseline;
    margin-bottom: 8px;
  }

  .home-section .section-heading > div {
    gap: 2px;
  }

  .home-section .eyebrow {
    display: none;
  }

  .home-section h2 {
    font-size: clamp(1.25rem, 1.55vw, 1.38rem);
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .home-section .section-heading a {
    align-self: end;
    font-size: 0.88rem;
    line-height: 1.3;
    padding-bottom: 1px;
  }

  .home-heading-chip {
    --chip-bg: rgba(255, 250, 241, 0.92);
    --chip-border: rgba(159, 79, 47, 0.28);
    --chip-accent: var(--accent);
    --icon-bg: #f9dfcf;
    --icon-fg: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    border: 1px solid var(--chip-border);
    border-radius: 999px;
    background: var(--chip-bg);
    box-shadow: 0 10px 26px rgba(61, 44, 25, 0.07), inset 0 1px 0 rgba(255, 255, 255, 0.62);
    padding: 4px 12px 4px 5px;
  }

  .home-heading-chip::after {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--chip-accent);
    opacity: 0.46;
  }

  .home-heading-latest {
    --chip-bg: #ffe8b8;
    --chip-border: rgba(184, 107, 31, 0.36);
    --chip-accent: #a65f18;
    --icon-bg: #fff7df;
    --icon-fg: #a65f18;
  }

  .home-heading-bci {
    --chip-bg: #dfeccf;
    --chip-border: rgba(79, 112, 62, 0.34);
    --chip-accent: #4f703e;
    --icon-bg: #f5faec;
    --icon-fg: #4f703e;
  }

  .home-heading-pharma {
    --chip-bg: #f2d6ca;
    --chip-border: rgba(159, 79, 47, 0.34);
    --chip-accent: #8f4328;
    --icon-bg: #fff2eb;
    --icon-fg: #8f4328;
  }

  .home-heading-genomics {
    --chip-bg: #d8ebe2;
    --chip-border: rgba(62, 105, 96, 0.34);
    --chip-accent: #3e6960;
    --icon-bg: #f1faf5;
    --icon-fg: #3e6960;
  }

  .home-heading-icon {
    display: grid;
    width: 28px;
    height: 28px;
    place-items: center;
    flex: 0 0 auto;
    border: 1px solid color-mix(in srgb, var(--icon-fg) 24%, transparent);
    border-radius: 999px;
    background: var(--icon-bg);
    color: var(--icon-fg);
  }

  .home-heading-pharma .home-heading-icon {
    background: linear-gradient(135deg, #fff6ef 0 49%, #f4c1af 50% 100%);
  }

  .home-heading-icon svg {
    width: 18px;
    height: 18px;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .home-heading-chip:hover .home-heading-icon {
    animation: home-icon-wiggle 520ms ease both;
  }

  @keyframes home-icon-wiggle {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    35% {
      transform: rotate(-8deg) scale(1.06);
    }
    70% {
      transform: rotate(6deg) scale(1.03);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-heading-chip:hover .home-heading-icon {
      animation: none;
    }
  }

  .grid,
  .article-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-card {
    min-height: 100%;
  }

  .compact-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .home-card-grid {
    gap: 12px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .article-link {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 22px;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 253, 248, 0.95), rgba(250, 241, 226, 0.72));
    box-shadow: var(--shadow-card);
    padding: 26px;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .article-card-compact .article-link {
    gap: 10px;
    border-radius: 18px;
    padding: 14px 15px;
  }

  .article-card-compact .card-topline {
    gap: 8px;
  }

  .article-card-compact .card-topline time {
    font-size: 0.76rem;
  }

  .article-card-compact .card-badges {
    gap: 6px;
  }

  .article-card-compact .section-pill,
  .article-card-compact .order-badge {
    font-size: 0.72rem;
    padding: 5px 8px;
  }

  .article-card-compact .card-body {
    gap: 4px;
  }

  .article-card-compact h3 {
    font-size: clamp(0.98rem, 1.4vw, 1.08rem);
    line-height: 1.34;
  }

  .article-card-compact .card-body p {
    display: -webkit-box;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }

  .article-card-compact .card-footer {
    display: none;
  }

  .article-link::after {
    content: "";
    position: absolute;
    inset: auto 24px 0;
    height: 3px;
    border-radius: 999px 999px 0 0;
