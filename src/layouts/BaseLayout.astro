---
import Header from '../components/Header.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.alternateName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page-shell">
      <Header />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>© {new Date().getFullYear()} {siteConfig.author}. Powered by Astro.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f7f3ea;
    --surface: #fffaf1;
    --surface-strong: #ffffff;
    --text: #24211d;
    --muted: #6f665c;
    --line: #eadfce;
    --accent: #b35c2e;
    --accent-strong: #7d351a;
    --shadow: 0 22px 60px rgba(68, 44, 21, 0.08);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at top left, rgba(255, 221, 179, 0.65), transparent 36rem),
      var(--bg);
    color: var(--text);
    line-height: 1.75;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
  }

  .page-shell {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 24px 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .brand-mark {
    display: grid;
    width: 36px;
    height: 36px;
    place-items: center;
    border-radius: 12px;
    background: var(--accent);
    color: white;
    font-weight: 800;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
  }

  .site-nav a {
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    padding: 8px 14px;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    background: rgba(179, 92, 46, 0.12);
    color: var(--accent-strong);
  }

  main {
    padding: 32px 0 64px;
  }

  .hero,
  .content-panel,
  .article-card,
  .post {
    background: rgba(255, 250, 241, 0.92);
    border: 1px solid var(--line);
    border-radius: 28px;
    box-shadow: var(--shadow);
  }

  .hero {
    display: grid;
    gap: 28px;
    padding: clamp(32px, 6vw, 72px);
  }

  .eyebrow,
  .article-meta {
    color: var(--accent-strong);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    margin: 0 0 8px;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    line-height: 1.22;
    margin: 0;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 5rem);
    letter-spacing: -0.06em;
  }

  h2 {
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    letter-spacing: -0.04em;
  }

  h3 {
    font-size: 1.2rem;
  }

  p {
    margin: 0;
  }

  .hero p,
  .lead {
    color: var(--muted);
    font-size: clamp(1rem, 2vw, 1.2rem);
    max-width: 720px;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin: 44px 0 18px;
  }

  .section-heading a {
    color: var(--accent-strong);
    font-weight: 700;
  }

  .grid {
    display: grid;
    gap: 18px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-card {
    transition: transform 160ms ease, box-shadow 160ms ease;
  }

  .article-card:hover {
    box-shadow: 0 26px 70px rgba(68, 44, 21, 0.12);
    transform: translateY(-2px);
  }

  .article-card a {
    display: grid;
    gap: 10px;
    height: 100%;
    padding: 24px;
  }

  .article-card p:not(.article-meta) {
    color: var(--muted);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
  }

  .tag-list li {
    background: #f2e4d2;
    border-radius: 999px;
    color: var(--accent-strong);
    font-size: 0.82rem;
    padding: 4px 10px;
  }

  .content-panel,
  .post {
    padding: clamp(24px, 5vw, 48px);
  }

  .list-header {
    display: grid;
    gap: 12px;
    margin-bottom: 28px;
  }

  .post {
    max-width: 820px;
    margin: 0 auto;
  }

  .post-header {
    display: grid;
    gap: 14px;
    margin-bottom: 34px;
  }

  .prose {
    color: #302b25;
    font-size: 1.05rem;
  }

  .prose h2,
  .prose h3 {
    margin-top: 2rem;
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose blockquote {
    margin: 1rem 0;
  }

  .prose a {
    color: var(--accent-strong);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose code {
    background: #f0e4d5;
    border-radius: 6px;
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    padding: 0.12em 0.32em;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.95rem;
    padding: 28px 0 40px;
    text-align: center;
  }

  @media (max-width: 760px) {
    .page-shell {
      width: min(100% - 24px, 1120px);
    }

    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding: 18px 0;
    }

    .site-nav {
      justify-content: flex-start;
      width: 100%;
    }

    .site-nav a {
      background: rgba(255, 255, 255, 0.55);
    }

    main {
      padding-top: 18px;
    }

    .grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
