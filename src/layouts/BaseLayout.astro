---
import Header from '../components/Header.astro';
import { siteConfig } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.alternateName}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-bg" aria-hidden="true"></div>
    <div class="page-shell">
      <Header />
      <main>
        <slot />
      </main>
      <footer class="site-footer">
        <p>{siteConfig.name} · {siteConfig.alternateName}</p>
        <p>© {new Date().getFullYear()} {siteConfig.author}. Powered by Astro.</p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f5efe4;
    --bg-deep: #ece1d1;
    --paper: #fffaf1;
    --paper-soft: #fbf4e8;
    --paper-strong: #fffdf8;
    --ink: #24201a;
    --ink-soft: #595044;
    --muted: #7a6d5f;
    --line: rgba(86, 64, 39, 0.16);
    --line-strong: rgba(86, 64, 39, 0.26);
    --accent: #9f4f2f;
    --accent-soft: #e7c2a8;
    --accent-wash: rgba(159, 79, 47, 0.1);
    --green-ink: #475f48;
    --shadow-soft: 0 24px 80px rgba(61, 44, 25, 0.1);
    --shadow-card: 0 18px 50px rgba(61, 44, 25, 0.08);
    --radius-xl: 34px;
    --radius-lg: 24px;
    --radius-md: 16px;
    --content-width: 1120px;
    --reading-width: 70ch;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    background: var(--bg);
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.78;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  body::before {
    content: "";
    position: fixed;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(67, 47, 24, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(67, 47, 24, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.45), transparent 72%);
    z-index: -2;
  }

  .site-bg {
    position: fixed;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: -3;
  }

  .site-bg::before,
  .site-bg::after {
    content: "";
    position: absolute;
    border-radius: 999px;
    filter: blur(10px);
  }

  .site-bg::before {
    width: min(58vw, 760px);
    height: min(58vw, 760px);
    left: -18vw;
    top: -22vw;
    background: radial-gradient(circle, rgba(231, 194, 168, 0.72), rgba(231, 194, 168, 0));
  }

  .site-bg::after {
    width: min(46vw, 620px);
    height: min(46vw, 620px);
    right: -14vw;
    top: 16vh;
    background: radial-gradient(circle, rgba(147, 166, 137, 0.28), rgba(147, 166, 137, 0));
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    max-width: 100%;
  }

  code,
  pre {
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
  }

  .page-shell {
    width: min(var(--content-width), calc(100% - 40px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 12px;
    z-index: 20;
    padding: 14px 0 18px;
  }

  .nav-frame {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border: 1px solid rgba(86, 64, 39, 0.14);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.82);
    box-shadow: 0 14px 44px rgba(61, 44, 25, 0.08);
    padding: 9px 10px 9px 12px;
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    min-width: max-content;
  }

  .brand-mark {
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 50%;
    background: linear-gradient(145deg, #a75332, #76351f);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 10px 22px rgba(121, 57, 31, 0.18);
    color: #fff8ef;
    font-weight: 800;
  }

  .brand-copy {
    display: grid;
    gap: 1px;
    line-height: 1.15;
  }

  .brand-copy strong {
    font-size: 1rem;
    letter-spacing: 0.02em;
  }

  .brand-copy small {
    color: var(--muted);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .site-nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 4px;
  }

  .site-nav a {
    border-radius: 999px;
    color: var(--ink-soft);
    font-size: 0.94rem;
    font-weight: 650;
    line-height: 1;
    padding: 12px 15px;
    transition: background 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .site-nav a:hover {
    background: rgba(159, 79, 47, 0.08);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .site-nav a[aria-current="page"] {
    background: var(--ink);
    color: var(--paper-strong);
  }

  main {
    padding: 42px 0 78px;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: clamp(28px, 5vw, 60px);
    align-items: end;
    min-height: 520px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(125deg, rgba(255, 253, 248, 0.95), rgba(251, 244, 232, 0.86)),
      radial-gradient(circle at 82% 18%, rgba(159, 79, 47, 0.18), transparent 28rem);
    box-shadow: var(--shadow-soft);
    padding: clamp(32px, 7vw, 84px);
  }

  .home-hero {
    grid-template-columns: 1fr;
    align-items: center;
    min-height: auto;
    margin-top: -12px;
    padding: clamp(18px, 3vw, 30px) clamp(22px, 4vw, 42px);
  }

  .home-hero::before {
    inset: 10px;
    border-radius: 24px;
  }

  .home-hero .hero-content {
    gap: 8px;
  }

  .home-hero h1 {
    font-size: clamp(1.9rem, 4.4vw, 3.1rem);
    letter-spacing: -0.045em;
  }

  .home-hero p {
    max-width: 58ch;
    font-size: clamp(0.98rem, 1.5vw, 1.08rem);
    line-height: 1.72;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 18px;
    border: 1px solid rgba(86, 64, 39, 0.11);
    border-radius: calc(var(--radius-xl) - 12px);
    pointer-events: none;
  }

  .hero-content,
  .hero-card {
    position: relative;
  }

  .hero-content {
    display: grid;
    gap: 24px;
  }

  .hero-card {
    display: grid;
    gap: 16px;
    border: 1px solid rgba(86, 64, 39, 0.14);
    border-radius: var(--radius-lg);
    background: rgba(255, 253, 248, 0.72);
    padding: 26px;
  }

  .hero-card .stamp {
    width: 62px;
    height: 62px;
    display: grid;
    place-items: center;
    border: 1px solid rgba(159, 79, 47, 0.32);
    border-radius: 20px;
    color: var(--accent);
    font-size: 1.55rem;
    font-weight: 800;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .hero-meta span,
  .section-pill,
  .tag-list li {
    border: 1px solid rgba(159, 79, 47, 0.16);
    border-radius: 999px;
    background: rgba(255, 250, 241, 0.78);
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1;
    padding: 7px 11px;
  }

  .eyebrow,
  .article-meta,
  .post-kicker {
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    margin: 0;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3 {
    color: var(--ink);
    line-height: 1.18;
    margin: 0;
  }

  h1 {
    font-family: Georgia, "Times New Roman", "Noto Serif SC", "Songti SC", serif;
    font-size: clamp(2.8rem, 8vw, 6.6rem);
    font-weight: 700;
    letter-spacing: -0.07em;
  }

  h2 {
    font-family: Georgia, "Times New Roman", "Noto Serif SC", "Songti SC", serif;
    font-size: clamp(1.7rem, 4vw, 2.8rem);
    letter-spacing: -0.045em;
  }

  h3 {
    font-size: clamp(1.18rem, 2vw, 1.38rem);
    letter-spacing: -0.02em;
  }

  p {
    margin: 0;
  }

  .hero p,
  .lead {
    color: var(--ink-soft);
    font-size: clamp(1rem, 2vw, 1.18rem);
    line-height: 1.9;
    max-width: 66ch;
  }

  .section-heading {
    align-items: end;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    margin: 58px 0 22px;
  }

  .section-heading > div {
    display: grid;
    gap: 8px;
  }

  .section-heading a,
  .back-link {
    color: var(--accent);
    font-weight: 800;
    text-underline-offset: 5px;
  }

  .section-heading a:hover,
  .back-link:hover {
    text-decoration: underline;
  }

  .home-section {
    position: relative;
  }

  .home-hero + .home-section .section-heading {
    margin-top: 28px;
  }

  .home-section + .home-section {
    margin-top: 2px;
  }

  .compact-section .section-heading {
    margin-top: 34px;
  }

  .grid,
  .article-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .article-card {
    min-height: 100%;
  }

  .compact-grid {
    grid-template-columns: minmax(0, 1fr);
  }

  .article-link {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 22px;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 253, 248, 0.95), rgba(250, 241, 226, 0.72));
    box-shadow: var(--shadow-card);
    padding: 26px;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .article-link::after {
    content: "";
    position: absolute;
    inset: auto 24px 0;
    height: 3px;
    border-radius: 999px 999px 0 0;
    background: linear-gradient(90deg, transparent, var(--accent-soft), transparent);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .article-link:hover {
    border-color: var(--line-strong);
    box-shadow: 0 22px 65px rgba(61, 44, 25, 0.13);
    transform: translateY(-3px);
  }

  .article-link:hover::after {
    opacity: 1;
  }

  .card-topline,
  .card-footer {
    align-items: center;
    display: flex;
    justify-content: space-between;
    gap: 14px;
  }

  .card-topline time {
    color: var(--muted);
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .card-body {
    display: grid;
    gap: 10px;
  }

  .card-body p {
    color: var(--ink-soft);
  }

  .card-footer {
    align-items: flex-end;
    border-top: 1px solid rgba(86, 64, 39, 0.11);
    padding-top: 18px;
  }

  .read-more {
    color: var(--accent);
    font-size: 0.92rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tag-list li {
    background: rgba(159, 79, 47, 0.08);
    font-size: 0.78rem;
    padding: 6px 9px;
  }

  .content-panel {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: rgba(255, 250, 241, 0.72);
    box-shadow: var(--shadow-soft);
    padding: clamp(28px, 5vw, 54px);
  }

  .list-header {
    display: grid;
    gap: 14px;
    margin-bottom: 34px;
    max-width: 760px;
  }

  .post-shell {
    max-width: 920px;
    margin: 0 auto;
  }

  .post {
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: rgba(255, 253, 248, 0.82);
    box-shadow: var(--shadow-soft);
    padding: clamp(28px, 6vw, 72px);
  }

  .post-header {
    display: grid;
    gap: 18px;
    margin-bottom: clamp(34px, 6vw, 58px);
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }

  .post-header h1 {
    max-width: 12ch;
  }

  .post-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .post-meta-row .dot {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: var(--accent-soft);
  }

  .prose {
    counter-reset: chapter;
    max-width: var(--reading-width);
    color: #302a23;
    font-size: clamp(1.02rem, 1.5vw, 1.12rem);
    line-height: 1.95;
    margin: 0 auto;
  }

  .prose > *:first-child {
    margin-top: 0;
  }

  .prose > *:last-child {
    margin-bottom: 0;
  }

  .prose > h1:first-child {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .prose h2 {
    counter-increment: chapter;
    position: relative;
    margin: 3rem -1rem 1.15rem;
    padding: 18px 22px 18px 28px;
    border: 1px solid rgba(159, 79, 47, 0.14);
    border-left: 5px solid var(--accent);
    border-radius: 20px;
    background:
      linear-gradient(90deg, rgba(159, 79, 47, 0.1), rgba(255, 250, 241, 0.72)),
      var(--paper-soft);
    box-shadow: 0 12px 34px rgba(61, 44, 25, 0.06);
    font-family: Georgia, "Times New Roman", "Noto Serif SC", "Songti SC", serif;
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    letter-spacing: -0.02em;
  }

  .prose h2::before {
    content: "章节 " counter(chapter, decimal-leading-zero);
    display: block;
    color: var(--accent);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    line-height: 1;
    margin-bottom: 8px;
    text-transform: uppercase;
  }

  .prose h3 {
    position: relative;
    margin: 2rem 0 0.7rem;
    padding-left: 18px;
    color: #3a332b;
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", "PingFang SC", sans-serif;
    font-size: clamp(1.16rem, 2vw, 1.36rem);
    font-weight: 800;
    letter-spacing: -0.01em;
  }

  .prose h3::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 5px rgba(159, 79, 47, 0.1);
  }

  .prose p,
  .prose ul,
  .prose ol,
  .prose blockquote,
  .prose pre,
  .prose table {
    margin: 1.1rem 0;
  }

  .prose ul,
  .prose ol {
    padding-left: 1.45rem;
  }

  .prose ul.contains-task-list,
  .prose ol.contains-task-list {
    display: grid;
    gap: 0.72rem;
    list-style: none;
    padding-left: 0;
  }

  .prose .task-list-item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.68rem;
    align-items: start;
    border: 1px solid rgba(86, 64, 39, 0.12);
    border-radius: 14px;
    background: rgba(255, 250, 241, 0.58);
    padding: 0.72rem 0.86rem;
  }

  .prose input[type="checkbox"] {
    appearance: none;
    display: inline-grid;
    width: 1rem;
    height: 1rem;
    place-content: center;
    border: 1.5px solid rgba(159, 79, 47, 0.42);
    border-radius: 5px;
    background: var(--paper-strong);
    margin: 0.35em 0 0;
  }

  .prose input[type="checkbox"]:checked::before {
    content: "";
    width: 0.48rem;
    height: 0.48rem;
    border-radius: 2px;
    background: var(--accent);
  }

  .prose li::marker {
    color: var(--accent);
    font-weight: 800;
  }

  .prose li + li {
    margin-top: 0.48rem;
  }

  .prose a {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  .prose blockquote {
    position: relative;
    border: 1px solid rgba(159, 79, 47, 0.14);
    border-left: 5px solid var(--accent-soft);
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(159, 79, 47, 0.07), rgba(255, 250, 241, 0.76));
    color: var(--ink-soft);
    padding: 42px 22px 18px;
  }

  .prose blockquote::before {
    content: "提示";
    position: absolute;
    left: 18px;
    top: 14px;
    border-radius: 999px;
    background: rgba(159, 79, 47, 0.1);
    color: var(--accent);
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1;
    padding: 5px 8px;
  }

  .prose blockquote > :first-child {
    margin-top: 0;
  }

  .prose blockquote > :last-child {
    margin-bottom: 0;
  }

  .prose hr {
    height: 1px;
    border: 0;
    background: linear-gradient(90deg, transparent, var(--line-strong), transparent);
    margin: 2.6rem 0;
  }

  .prose code {
    border: 1px solid rgba(86, 64, 39, 0.12);
    border-radius: 7px;
    background: #f1e6d8;
    color: #6e321d;
    font-size: 0.92em;
    padding: 0.12em 0.34em;
  }

  .prose pre {
    overflow-x: auto;
    border: 1px solid rgba(86, 64, 39, 0.16);
    border-radius: 18px;
    background: #28231d;
    color: #fff7e9;
    padding: 18px 20px;
  }

  .prose pre code {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0;
  }

  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: rgba(255, 250, 241, 0.72);
    box-shadow: 0 12px 30px rgba(61, 44, 25, 0.05);
    -webkit-overflow-scrolling: touch;
  }

  .prose th,
  .prose td {
    border-bottom: 1px solid var(--line);
    padding: 11px 14px;
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    background: rgba(159, 79, 47, 0.08);
    color: var(--ink);
    font-weight: 800;
    min-width: 9rem;
  }

  .prose tbody tr:nth-child(even) {
    background: rgba(255, 253, 248, 0.55);
  }

  .prose tr:last-child td {
    border-bottom: 0;
  }

  .site-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 18px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
    padding: 26px 0 40px;
  }

  @media (max-width: 860px) {
    .page-shell {
      width: min(100% - 28px, var(--content-width));
    }

    .site-header {
      top: 8px;
      padding-top: 10px;
    }

    .nav-frame {
      align-items: flex-start;
      border-radius: 28px;
      flex-direction: column;
      padding: 12px;
    }

    .site-nav {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(92px, 1fr));
      width: 100%;
    }

    .site-nav a {
      text-align: center;
      padding: 11px 8px;
    }

    main {
      padding: 24px 0 58px;
    }

    .hero {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .home-hero + .home-section .section-heading {
      margin-top: 24px;
    }

    .grid,
    .article-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 44px;
    }

    .card-footer {
      align-items: flex-start;
